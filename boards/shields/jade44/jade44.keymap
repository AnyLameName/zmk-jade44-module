#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define HACK    3
#define FUNC    4

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";

      bindings = <
        &kp GRAVE  &kp Q  &kp W          &kp E      &kp R     &kp T            &kp Y     &kp U      &kp I      &kp O     &kp P     &kp BSLH
        &kp LGUI   &kp A  &kp S          &kp D      &kp F     &kp G            &kp H     &kp J      &kp K      &kp L     &kp SEMI  &kp SINGLE_QUOTE
        &kp LCTRL  &kp Z  &kp X          &kp C      &kp V     &kp B            &kp N     &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp LALT
                          &kp LC(LSHFT)  &mo LOWER  &kp BSPC  &kp LSHFT        &mo FUNC  &kp SPACE  &mo RAISE  &mo HACK
      >;
    };

    lower_layer {
      display-name = "Lower";

      bindings = <
        &trans  &kp N1  &kp N2  &kp N3   &kp N4   &kp N5           &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
        &trans  &trans  &trans  &kp ESC  &kp TAB  &trans           &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
        &trans  &trans  &trans  &trans   &trans   &kp UNDER        &kp PLUS  &trans    &trans  &trans     &trans  &trans
                        &trans  &trans   &trans   &trans           &trans    &trans    &trans  &trans
      >;
    };

    raise_layer {
      display-name = "Raise";

      bindings = <
        &trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)        &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
        &trans  &trans      &trans      &trans      &trans      &trans            &trans      &kp ENTER   &trans      &trans      &trans      &trans
        &trans  &trans      &trans      &trans      &trans      &kp UNDER         &kp PLUS    &trans      &trans      &trans      &trans      &trans
                            &trans      &trans      &trans      &trans            &trans      &trans      &trans      &trans
      >;
    };

    hack_layer {
      display-name = "Hack";

      bindings = <
        &trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4        &trans  &trans        &trans        &trans      &kp C_PP  &trans
        &trans  &bt BT_CLR_ALL  &trans        &trans        &trans           &trans              &trans  &kp C_VOL_DN  &kp C_VOL_UP  &kp LG(L)   &trans    &trans
        &trans  &trans          &bt BT_CLR    &trans        &trans           &trans              &trans  &kp C_MUTE    &kp C_PREV    &kp C_NEXT  &trans    &trans
                                &trans        &trans        &kp LC(LA(DEL))  &trans              &trans  &trans        &trans        &trans
      >;
    };

    func_layer {
      display-name = "Func";

      bindings = <
        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6        &kp F7    &kp F8     &kp F9     &kp F10  &kp F11  &kp F12
        &trans  &trans  &trans  &trans  &trans  &trans        &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &trans   &trans
        &trans  &trans  &trans  &trans  &trans  &trans        &trans    &trans     &trans     &trans   &trans   &trans
                        &trans  &trans  &trans  &trans        &trans    &trans     &trans     &trans
      >;
    };
  };
};
